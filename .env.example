# Copy to .env (never commit the real file) and export the variables before `npm start`.

# Google Gemini API key. Optional: without it the app uses its built-in rule-based narrator.
GEMINI_API_KEY=
# Any Gemini model that supports generateContent.
GEMINI_MODEL=gemini-2.5-flash

PORT=3000
# Set to 1 when running behind a single reverse proxy (Render, Vercel, Nginx) so rate limits use the real client IP.
TRUST_PROXY=0
