{
  "name": "urban-air-assistant",
  "version": "1.0.0",
  "description": "GenAI-powered assistant that helps families and communities navigate severe winter smog with personalised, quantified, low-emission routines.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=95 --test-coverage-exclude=\"test/**\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p .",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "verify": "npm run check && npm run coverage"
  },
  "keywords": [
    "air-quality",
    "aqi",
    "smog",
    "genai",
    "gemini",
    "accessibility"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "linkedom": "^0.18.15",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3"
  }
}
